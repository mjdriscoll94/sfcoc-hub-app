# Existing application variables are omitted. Copy the relevant values from
# your existing .env.local, then add these server-only MCP variables.

# Neon pooled connection string. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public deployment origin with no trailing slash.
MCP_BASE_URL=https://app.example.com

# Static OAuth client credentials entered when creating the ChatGPT app.
MCP_OAUTH_CLIENT_ID=church-directory-chatgpt
MCP_OAUTH_CLIENT_SECRET=replace-with-a-long-random-secret

# Comma-separated exact callback URL(s) shown by ChatGPT's app setup screen.
MCP_OAUTH_REDIRECT_URIS=https://replace-with-callback-shown-by-chatgpt.example/callback

# Password entered by an authorized directory administrator on the consent page.
MCP_AUTH_PASSWORD=replace-with-a-long-unique-password

# At least 32 random bytes; used only to sign short-lived access/refresh tokens.
MCP_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Optional comma-separated browser origins. Requests without Origin are allowed.
MCP_ALLOWED_ORIGINS=https://chatgpt.com
