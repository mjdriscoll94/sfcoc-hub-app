rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leadership course records are served only through authenticated server APIs.
    // Firebase Admin bypasses client rules after verifying membership or administrator access.
    match /leadershipLessons/{document=**} {
      allow read, write: if false;
    }

    // Prayer Board records are served only through authenticated server APIs so
    // confidential requests, authorship, follows, updates, and exports can be enforced.
    match /prayerPraise/{document=**} {
      allow read, write: if false;
    }

    // Temporary rule retained for existing collections until their rules are migrated.
    match /{topLevelCollection}/{document=**} {
      allow read, write: if topLevelCollection != 'leadershipLessons'
        && topLevelCollection != 'prayerPraise';
    }

    // These rules will be uncommented after initialization
    // match /prayerPraise/{document} {
    //   allow read: if true;
    //   allow create: if request.auth != null;
    //   allow update: if request.auth != null;
    // }

    // match /announcements/{document} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }

    // match /volunteerOpportunities/{document} {
    //   allow read: if true;
    //   allow create: if request.auth != null;
    //   allow update: if request.auth != null;
    // }
  }
}
